
graph TB
    subgraph "BEFORE HACS Conversion"
        A[Repository Root] --> B[__init__.py]
        A --> C[sensor.py]
        A --> D[manifest.json]
        A --> E[README.md]
        A --> F[config_flow.py]
        A --> G[const.py]
        A --> H[Other Python files]

        D --> D1[Basic manifest fields:<br/>- domain<br/>- name<br/>- documentation<br/>- requirements]
        E --> E1[Manual installation<br/>instructions only]

        style A fill:#ffcccc
        style D fill:#ffeeee
        style E fill:#ffeeee
